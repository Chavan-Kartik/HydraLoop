# The backend image needs reports/examples/ at runtime: the ledger source reads
# the curated exemplars from there to serve the investigation and lineage views.
# Only the generated run artefacts are excluded.
reports/runs/
reports/lab/
reports/*.png
reports/*.parquet

# Front end, tests and docs have no place in the API image.
ui/
tests/
docs/
.github/

.venv/
venv/
__pycache__/
*.pyc
*.pyo
.env
.git/
.pytest_cache/
.ruff_cache/
